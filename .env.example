# =======================================================
# Adaptive Cyber Defense Framework — Environment Variables
# =======================================================
# Copy this file to .env and fill in your values.
# Do NOT commit .env with real credentials to version control.

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=cyberdefense
DATABASE_URL=postgresql://postgres:change_me_in_production@db:5432/cyberdefense

# JWT Authentication Secrets
JWT_SECRET_KEY=change_this_to_a_random_64_char_string
JWT_REFRESH_SECRET_KEY=change_this_to_another_random_64_char_string

# Moving Target Defense (MTD)
MTD_ENABLED=True
MTD_ROTATION_INTERVAL_SECONDS=60

# AI / Video Surveillance
MODEL_PATH=ai-engine/models/best.pt

# Frontend API URL (used during Vite build for Docker)
# Leave empty when served behind Nginx proxy in Docker
VITE_API_URL=http://localhost:8000
